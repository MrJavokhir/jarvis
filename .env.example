# ─────────────────────────────────────────────────────────────
#  Jarvis Reminder Bot — muhit o'zgaruvchilari
#  Bu faylni `.env` deb nusxalab, qiymatlarni to'ldiring.
# ─────────────────────────────────────────────────────────────

# Telegram bot tokeni — @BotFather'dan olinadi (majburiy)
TELEGRAM_BOT_TOKEN=

# Claude API kaliti — console.anthropic.com (majburiy)
# Ovozdan olingan matndan vazifa + sana/vaqtni ajratib oladi.
ANTHROPIC_API_KEY=

# OpenAI API kaliti — platform.openai.com (majburiy)
# Faqat ovozni matnga o'girish (Whisper / gpt-4o-transcribe) uchun ishlatiladi.
OPENAI_API_KEY=

# Mini App joylashgan ochiq HTTPS manzil (majburiy: deployda)
# Masalan: https://jarvis-production.up.railway.app
# BotFather → /setmenubutton ichida ham shu manzil ko'rsatiladi.
PUBLIC_URL=

# ─── Ixtiyoriy sozlamalar ───────────────────────────────────

# Bot rejimi: polling (lokal test) yoki webhook (deploy)
# Bo'sh qoldirilsa: PUBLIC_URL bo'lsa webhook, bo'lmasa polling.
BOT_MODE=

# Webhook uchun maxfiy token (webhook rejimida tavsiya etiladi).
# Bo'sh qoldirilsa avtomatik generatsiya qilinadi.
TELEGRAM_WEBHOOK_SECRET=

# Server porti (Railway/Render o'zi beradi)
PORT=3000

# Standart vaqt mintaqasi — foydalanuvchi o'zgartirmaguncha shu ishlatiladi
DEFAULT_TIMEZONE=Asia/Tashkent

# SQLite ma'lumotlar bazasi papkasi.
# Railway'da volume mount qilingan yo'lni ko'rsating, masalan: /data
DATA_DIR=./data

# Eslatmalarni tekshirish davri (sekund)
SCHEDULER_INTERVAL_SECONDS=30

# Ovozli xabar uchun maksimal uzunlik (sekund)
MAX_VOICE_DURATION_SECONDS=300

# Speech-to-text modeli: gpt-4o-transcribe | gpt-4o-mini-transcribe | whisper-1
STT_MODEL=gpt-4o-transcribe

# Log darajasi: debug | info | warn | error
LOG_LEVEL=info
